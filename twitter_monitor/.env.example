# Twitter/X API Bearer Token (developer.twitter.com で取得)
TWITTER_BEARER_TOKEN=your_bearer_token_here

# 監視対象のTwitterアカウント (@ は不要)
TWITTER_USERNAME=target_username

# 検知したいキーワード
WATCH_KEYWORD=監視ワード

# ntfy.sh のトピック名 (自分だけが知るランダムな文字列を推奨)
NTFY_TOPIC=your_unique_topic_name

# チェック間隔（秒）。デフォルト5分 = 300秒
CHECK_INTERVAL_SECONDS=300
